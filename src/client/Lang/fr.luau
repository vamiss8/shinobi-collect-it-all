		GuideFinish = "C'est parti !",
		GuideSkip = "Passer",
		Guide_hello = "Salut, je suis {r|Iruka}, ton professeur ! Je vais te montrer comment un shinobi devient fort ici. Ce sera rapide.",
		Guide_train = "D'abord, rassemble du {y|chakra}. Prends {b|Méditer} (touche 1) et reste immobile, ou {b|Contrôle du chakra} (touche 2) et clique quand les anneaux se rejoignent.",
		Guide_train_touch = "D'abord, rassemble du {y|chakra}. Touche {b|Méditer} (la première case en bas) et reste immobile, ou {b|Contrôle du chakra} (la deuxième) et touche l'écran quand les anneaux se rejoignent.",
		Guide_bar = "Appuie quand le repère est dans la bande {r|PARFAIT} : plus de puissance, un lancer {r|plus lointain}. Puis {r|rentre chez toi} avant que l'ennemi de la zone t'attrape !",
		Guide_run = "Rentre chez toi !",
		Guide_income = "Un shinobi sur une plateforme rapporte des {y|Ryo} chaque seconde, et {g|la moitié} même quand tu es absent. Tes Ryo sont ici.",
		Guide_groupServer = "Et rejoins notre {r|serveur Discord} : le lien est sur la {b|page du jeu}.",
		Guide_bye = "C'est tout pour l'instant ! Je reviendrai dès que tu rencontreras quelque chose de nouveau. Bonne chance, shinobi !",
		Guide_caught = "Attrapé ! L'ennemi a pris ton shinobi mais t'a laissé quelques {y|Ryo}. Relance et rentre tout droit chez toi.",
		Guide_strip = "Va maintenant à la {b|bande de lancer} au début du chemin : suis les {r|flèches rouges} au sol.",
		Guide_place = "Tu as attrapé un shinobi ! Suis les flèches jusqu'à {b|ton dojo} et appuie sur la {r|plateforme qui brille} pour l'y placer.",
		Guide_placeFull = "Toutes tes plateformes sont prises : appuie sur la {r|plateforme qui brille} pour {r|échanger} le shinobi que tu portes avec celui qui s'y trouve.",
		Guide_power = "Ton kunai vole aussi loin que ton {y|chakra} le permet. {r|Appuie sur ton indicateur de chakra}, ici en bas à gauche.",
		Guide_power_touch = "Ton kunai vole aussi loin que ton {y|chakra} le permet. {r|Touche ton indicateur de chakra}, ici en haut à gauche.",
		Guide_slider = "Ici, tu choisis combien de {y|chakra} prend un lancer : {r|fais glisser le curseur} ou tape un montant, pour viser une {r|zone plus proche}. {r|Appuie sur la croix} pour fermer.",
		Guide_tenten = "Dépense tes {y|Ryo} dans les boutiques. D'abord les {b|Outils ninja de Tenten} : ses kunai donnent plus de {y|chakra} par répétition. Suis les flèches et {r|place-toi dans le cercle}.",
		Guide_speed = "Ensuite, le {b|Terrain d'entraînement de la jeunesse} : il vend de la {r|vitesse} pour distancer les ennemis des zones lointaines. {r|Place-toi dans le cercle}.",
		Guide_sell = "Le {b|Bureau des missions} paie des {y|Ryo} pour les shinobi que tu envoies en dernière mission : ceux dont tu n'as plus besoin. {r|Place-toi dans le cercle}.",
		Guide_herbs = "Enfin, les {b|Remèdes de Kabuto} : chaque prise ramenée rapporte des {y|Herbes}, et ici elles achètent des potions qui boostent chakra, Ryo ou chance. {r|Place-toi dans le cercle}.",
		Guide_inventory = "Maintenant tes fenêtres. {r|Appuie sur Inventaire} : tous les shinobi qui ne sont pas sur une plateforme y attendent ; appuie sur l'un d'eux pour le porter. Ferme la fenêtre pour continuer.",
		Guide_book = "{r|Appuie sur Bingo Book} : tous les shinobi que tu as attrapés, une page par mutation. Une page complète donne un bonus permanent. Ferme-le pour continuer.",
		Guide_shop = "{r|Appuie sur Boutique} : des passes pour toujours, des potions premium, des Ryo et les shinobi légendaires. Ferme-la pour continuer.",
		Guide_awards = "{r|Appuie sur Succès} : chaque exploit y a sa récompense ; récupère-la quand un {r|!} apparaît. Ferme-le pour continuer.",
		Guide_board = "Perdu ? Le {b|tableau d'affichage} a comment jouer, les nouveautés et toutes les chances : va et {r|place-toi dans le cercle}, puis appuie sur Lire quand tu veux.",
		Guide_settings = "{r|Appuie sur la roue dentée} : les paramètres ont beaucoup d'utile : volume de la musique et des sons, langue, une police simple, le lecteur de musique du village et l'{b|Aide} avec comment jouer, les nouveautés, les chances et ce tutoriel. Ferme-les pour continuer.",
		Guide_group = "Rejoins le groupe {r|sad mansion studios} et aime le jeu, puis prends le {b|cadeau} : {r|place-toi dans le cercle}. Pas compté ? Relance le jeu.",
		Tip_ring = "{b|Contrôle du chakra} : clique quand l'anneau qui se resserre touche la cible. {r|PARFAIT} donne le plus de {y|chakra} ; si tu bouges, l'outil est rangé.",
		Tip_ring_touch = "{b|Contrôle du chakra} : touche l'écran quand l'anneau qui se resserre touche la cible. {r|PARFAIT} donne le plus de {y|chakra} ; si tu bouges, l'outil est rangé.",
		Tip_reborn = "Renaissance ! Ton chakra, tes shinobi, tes Ryo et ta vitesse repartent de zéro, mais ton nouveau rang paie plus pour toujours et te donne une vitesse de départ. Les orbes derrière toi montrent ton rang.",
		Tip_offline = "Pendant ton absence, ton dojo a rapporté la {g|moitié} de ses revenus, jusqu'à {g|trois jours}. Reviens souvent !",
		Tip_legend = "Voici les {r|shinobi légendaires}. Acheté dans la {b|Boutique}, l'un d'eux reste après chaque renaissance et s'améliore comme les autres.",
		Tip_leaders = "Les {b|classements} : quel dojo rapporte le plus de {y|Ryo} par seconde et qui a le plus de {y|chakra} en ce moment.",
		Tip_seal = "Un {r|sceau bonus} ! Clique dessus pendant l'entraînement : il multiplie un temps le chakra que tu rassembles ({g|x2}, {g|x5} ou {g|x10}).",
		Tip_seal_touch = "Un {r|sceau bonus} ! Touche-le pendant l'entraînement : il multiplie un temps le chakra que tu rassembles ({g|x2}, {g|x5} ou {g|x10}).",
		Tip_mutation = "Une {r|mutation} ! Avec son aura il rapporte {g|bien plus} : de Chakra {g|x1,5} à Six Chemins {g|x20}. Chaque mutation a sa page dans le {b|Bingo Book}, et la {r|chance} augmente la probabilité. Tout est dans {b|Aide > Chances}.",
		Tip_nextRank = "Une trouvaille rare : un shinobi d'un {r|rang au-dessus} de la zone. Plus ton kunai tombe loin dans la zone, plus c'est probable.",
		Tip_caught = "Attrapé ! L'ennemi a pris le shinobi et t'a laissé quelques {y|Ryo}. Les ennemis courent plus vite au fond d'une zone : achète de la {r|vitesse} au {b|Terrain d'entraînement de la jeunesse}. La prévision montre qui tu peux distancer.",
		Tip_herbs = "Des {y|Herbes} ! Chaque prise ramenée en donne : plus des zones lointaines et le {g|double} pour un {r|PARFAIT}. Achète des potions avec aux {b|Remèdes de Kabuto}.",
		Tip_twin = "Celui-ci a un {r|jumeau exact} : même shinobi, même mutation, mêmes étoiles. Ouvre l'{b|Inventaire} et appuie sur {r|Fusionner}, ou porte-le sur la plateforme de son jumeau. L'Inventaire brille en violet tant qu'une fusion attend.",
		Tip_merged = "{r|Fusion} ! Il a une étoile de plus et rapporte {g|2,5 fois} plus. Après deux étoiles dorées viennent deux de {b|platine}, puis celles des {r|Six Chemins} : trois d'entre elles, {g|sept} fusions en tout, c'est le maximum. Fusionne des jumeaux encore et encore.",
		Tip_upgrade = "Tu peux payer une {r|amélioration} : la console au pied d'une plateforme achète des niveaux ({b|+1}, {b|+10} ou {b|MAX}). Chaque niveau donne {g|x1,25} de revenus, et le shinobi grandit.",
		Tip_kunai = "Tu peux payer un meilleur kunai chez {b|Tenten} : plus de {y|chakra} à chaque répétition d'entraînement.",
		Tip_speed = "Tu peux acheter de la {r|vitesse} au {b|Terrain d'entraînement de la jeunesse}. Des jambes plus rapides distancent les ennemis des zones lointaines.",
		Tip_pads = "Tu peux acheter une autre {r|plateforme} : appuie sur le panneau de la suivante dans ton dojo. Plus de plateformes, plus de revenus.",
		Tip_floor = "Un nouvel {r|étage} ! Ton dojo grandit d'un étage toutes les {g|dix} plateformes : prends l'escalier.",
		Tip_potion = "Une potion t'attend dans ta {b|bourse}. Bois-la quand tu veux, dans l'onglet des boosts de la {b|Boutique} ou chez {b|Kabuto}. Les potions actives s'affichent en haut à gauche.",
		Tip_lucky = "Un {r|lancer chanceux} ! Chaque {g|10e}, {g|20e} et {g|100e} lancer multiplie la chance d'une prise rare et des mutations : {g|x2}, {g|x5}, {g|x10}. Garde-le pour un événement !",
