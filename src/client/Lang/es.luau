		Tip_lucky = "¡Un {r|lanzamiento de suerte}! Cada lanzamiento {g|10.º}, {g|20.º} y {g|100.º} multiplica la probabilidad de una captura rara y de mutaciones: {g|x2}, {g|x5}, {g|x10}. ¡Guárdalo para un evento!",
