		GuideFinish = "¡Vamos!",
		GuideSkip = "Saltar",
		Guide_hello = "¡Hola, soy {r|Iruka}, tu maestro! Te enseñaré cómo se hace fuerte un shinobi aquí. Será rápido.",
		Guide_train = "Primero, reúne {y|chakra}. Toma {b|Meditar} (tecla 1) y quédate quieto, o {b|Control de chakra} (tecla 2) y pulsa cuando los anillos se junten.",
		Guide_bar = "Pulsa cuando el marcador esté en la franja {r|PERFECTO}: más fuerza, un lanzamiento {r|más lejano}. ¡Luego {r|corre a casa} antes de que te atrape el enemigo de la zona!",
		Guide_run = "¡Corre a casa!",
		Guide_income = "Un shinobi en una plataforma gana {y|Ryo} cada segundo, y {g|la mitad} incluso cuando no estás. Tus Ryo están aquí.",
		Guide_groupServer = "Y únete a nuestro {r|servidor de la comunidad}: el enlace está en la {b|página del juego}.",
		Guide_bye = "¡Eso es todo por ahora! Volveré cada vez que encuentres algo nuevo. ¡Suerte, shinobi!",
