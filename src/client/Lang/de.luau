		GuideName = "IRUKA",
		GuideNext = "Weiter",
		GuideOk = "Verstanden",
		GuideFinish = "Los geht's!",
		GuideSkip = "Überspringen",
		Guide_hello = "Hallo, ich bin {r|Iruka}, dein Lehrer! Ich zeige dir, wie ein Shinobi hier stark wird. Es dauert nicht lange.",
		Guide_train = "Sammle zuerst {y|Chakra}. Nimm {b|Meditieren} (Taste 1) und steh still, oder {b|Chakra-Kontrolle} (Taste 2) und klicke, wenn sich die Ringe treffen.",
		Guide_train_touch = "Sammle zuerst {y|Chakra}. Tipp auf {b|Meditieren} (das erste Feld unten) und steh still, oder auf {b|Chakra-Kontrolle} (das zweite) und tipp, wenn sich die Ringe treffen.",
		Guide_bar = "Drück, wenn die Marke im {r|PERFEKT}-Band ist: mehr Kraft, ein {r|weiterer} Wurf. Dann {r|lauf nach Hause}, bevor dich der Gegner der Zone fängt!",
		Guide_run = "Lauf nach Hause!",
		Guide_income = "Ein Shinobi auf einer Plattform bringt jede Sekunde {y|Ryo}, und {g|die Hälfte} sogar, wenn du weg bist. Deine Ryo stehen hier.",
		Guide_groupServer = "Und komm auf unseren {r|Discord-Server}: der Link steht auf der {b|Seite des Spiels}.",
		Guide_bye = "Das war's fürs Erste! Ich komme wieder, wenn du etwas Neuem begegnest. Viel Glück, Shinobi!",
		Guide_caught = "Gefangen! Der Gegner hat deinen Shinobi genommen, dir aber ein paar {y|Ryo} gelassen. Wirf noch einmal und lauf direkt nach Hause.",
		Guide_strip = "Geh jetzt zum {b|Wurfstreifen} am Anfang der Bahn: folge den {r|roten Pfeilen} am Boden.",
		Guide_place = "Du hast einen Shinobi gefangen! Folge den Pfeilen in {b|dein Dojo} und drück auf die {r|leuchtende Plattform}, um ihn aufzustellen.",
		Guide_placeFull = "Alle deine Plattformen sind belegt: drück auf die {r|leuchtende Plattform}, um den getragenen Shinobi gegen den dort stehenden zu {r|tauschen}.",
		Guide_power = "Dein Kunai fliegt so weit, wie dein {y|Chakra} es erlaubt. {r|Tipp auf deine Chakra-Anzeige}, hier unten links.",
		Guide_power_touch = "Dein Kunai fliegt so weit, wie dein {y|Chakra} es erlaubt. {r|Tipp auf deine Chakra-Anzeige}, hier oben links.",
		Guide_slider = "Hier wählst du, wie viel {y|Chakra} ein Wurf nimmt: {r|zieh den Regler} oder tipp einen Betrag ein, um eine {r|nähere Zone} zu treffen. {r|Drück das Kreuz}, um ihn zu schließen.",
		Guide_tenten = "Gib deine {y|Ryo} in den Läden aus. Zuerst {b|Tentens Ninja-Werkzeuge}: ihre Kunai bringen mehr {y|Chakra} pro Wiederholung. Folge den Pfeilen und {r|stell dich in den Kreis}.",
		Guide_speed = "Dann der {b|Trainingsplatz der Jugend}: er verkauft {r|Laufgeschwindigkeit}, um den Gegnern ferner Zonen davonzulaufen. {r|Stell dich in den Kreis}.",
		Guide_sell = "Der {b|Missionsschalter} zahlt {y|Ryo} für Shinobi, die du auf eine letzte Mission schickst: die, die du nicht mehr brauchst. {r|Stell dich in den Kreis}.",
		Guide_herbs = "Zuletzt {b|Kabutos Heilmittel}: jeder heimgebrachte Fang bringt {y|Kräuter}, und hier kaufen sie Tränke, die Chakra, Ryo oder Glück steigern. {r|Stell dich in den Kreis}.",
		Guide_inventory = "Jetzt deine Fenster. {r|Drück auf Inventar}: dort warten alle Shinobi, die nicht auf einer Plattform stehen; drück auf einen, um ihn zu tragen. Schließ das Fenster, um weiterzumachen.",
		Guide_book = "{r|Drück auf Bingo-Buch}: alle Shinobi, die du gefangen hast, eine Seite pro Mutation. Eine volle Seite gibt einen dauerhaften Bonus. Schließ es, um weiterzumachen.",
		Guide_shop = "{r|Drück auf Shop}: Pässe für immer, Premium-Tränke, Ryo und die legendären Shinobi. Schließ ihn, um weiterzumachen.",
		Guide_awards = "{r|Drück auf Erfolge}: jede Tat hat dort ihre Belohnung; hol sie ab, wenn ein {r|!} erscheint. Schließ es, um weiterzumachen.",
		Guide_board = "Verloren? Das {b|Schwarze Brett} hat die Spielanleitung, Neuigkeiten und alle Chancen: geh hin und {r|stell dich in den Kreis}, dann drück auf Lesen, wann du willst.",
		Guide_settings = "{r|Drück auf das Zahnrad}: die Einstellungen haben viel Nützliches: Lautstärke von Musik und Sounds, Sprache, eine schlichte Schrift, den Musikspieler des Dorfes und die {b|Hilfe} mit Spielanleitung, Neuigkeiten, Chancen und diesem Tutorial. Schließ sie, um weiterzumachen.",
		Guide_group = "Tritt der Gruppe {r|sad mansion studios} bei und like das Spiel, dann nimm das {b|Geschenk}: {r|stell dich in den Kreis}. Nicht gezählt? Tritt dem Spiel neu bei.",
		Tip_ring = "{b|Chakra-Kontrolle}: klick, wenn der sich schließende Ring das Ziel trifft. {r|PERFEKT} gibt am meisten {y|Chakra}; bewegst du dich, wird das Werkzeug weggesteckt.",
		Tip_ring_touch = "{b|Chakra-Kontrolle}: tipp, wenn der sich schließende Ring das Ziel trifft. {r|PERFEKT} gibt am meisten {y|Chakra}; bewegst du dich, wird das Werkzeug weggesteckt.",
		Tip_reborn = "Wiedergeboren! Chakra, Shinobi, Ryo und Laufgeschwindigkeit fangen von vorn an, aber dein neuer Rang zahlt für immer mehr und gibt dir etwas Startgeschwindigkeit. Die Kugeln hinter dir zeigen deinen Rang.",
		Tip_offline = "Während du weg warst, hat dein Dojo die {g|Hälfte} seines Einkommens verdient, bis zu {g|drei Tage} lang. Komm oft wieder!",
		Tip_legend = "Das sind die {r|legendären Shinobi}. Im {b|Shop} gekauft, bleibt einer nach jeder Wiedergeburt und lässt sich wie jeder andere verbessern.",
		Tip_leaders = "Die {b|Bestenlisten}: wessen Dojo die meisten {y|Ryo} pro Sekunde bringt und wer gerade das meiste {y|Chakra} hat.",
		Tip_seal = "Ein {r|Bonussiegel}! Klick es beim Training an: es vervielfacht eine Weile das Chakra, das du sammelst ({g|x2}, {g|x5} oder {g|x10}).",
		Tip_seal_touch = "Ein {r|Bonussiegel}! Tipp es beim Training an: es vervielfacht eine Weile das Chakra, das du sammelst ({g|x2}, {g|x5} oder {g|x10}).",
		Tip_mutation = "Eine {r|Mutation}! Mit ihrer Aura bringt er {g|viel mehr}: von Chakra {g|x1,5} bis Sechs Pfade {g|x20}. Jede Mutation hat ihre Seite im {b|Bingo-Buch}, und {r|Glück} hebt die Chance. Alle stehen unter {b|Hilfe > Chancen}.",
		Tip_nextRank = "Ein seltener Fund: ein Shinobi vom {r|Rang über} dem der Zone. Je tiefer dein Kunai in der Zone landet, desto wahrscheinlicher.",
		Tip_caught = "Gefangen! Der Gegner hat den Shinobi genommen und dir ein paar {y|Ryo} gelassen. Tief in einer Zone laufen Gegner schneller: kauf {r|Laufgeschwindigkeit} auf dem {b|Trainingsplatz der Jugend}. Die Wurfvorschau zeigt, wem du davonläufst.",
		Tip_herbs = "{y|Kräuter}! Jeder heimgebrachte Fang bringt welche: mehr aus fernen Zonen und {g|doppelt so viele} für ein {r|PERFEKT}. Kauf damit Tränke bei {b|Kabutos Heilmitteln}.",
		Tip_twin = "Dieser hat einen {r|genauen Zwilling}: derselbe Shinobi, dieselbe Mutation, dieselben Sterne. Öffne das {b|Inventar} und drück {r|Verschmelzen}, oder trag ihn auf die Plattform seines Zwillings. Das Inventar leuchtet violett, solange eine Verschmelzung wartet.",
		Tip_merged = "{r|Verschmolzen}! Er hat einen Stern mehr und bringt {g|2,5-mal} so viel. Nach zwei goldenen Sternen kommen zwei {b|Platin}-Sterne, dann {r|Sechs-Pfade}-Sterne: drei davon, {g|sieben} Verschmelzungen insgesamt, sind das Höchste. Verschmilz Zwillinge immer wieder.",
		Tip_upgrade = "Du kannst dir ein {r|Upgrade} leisten: die Konsole am Fuß einer Plattform kauft Level ({b|+1}, {b|+10} oder {b|MAX}). Jedes Level bringt {g|x1,25} Einkommen, und der Shinobi wächst.",
		Tip_kunai = "Du kannst dir bei {b|Tenten} ein besseres Kunai leisten: mehr {y|Chakra} für jede Trainingswiederholung.",
		Tip_speed = "Du kannst {r|Laufgeschwindigkeit} auf dem {b|Trainingsplatz der Jugend} kaufen. Schnellere Beine laufen den Gegnern ferner Zonen davon.",
		Tip_pads = "Du kannst eine weitere {r|Plattform} kaufen: drück auf das Schild der nächsten in deinem Dojo. Mehr Plattformen, mehr Einkommen.",
		Tip_floor = "Ein neues {r|Stockwerk}! Dein Dojo wächst alle {g|zehn} Plattformen um ein Stockwerk: nimm die Treppe.",
		Tip_potion = "Ein Trank liegt in deinem {b|Beutel}. Trink ihn, wann du willst, im Boost-Reiter des {b|Shops} oder bei {b|Kabuto}. Laufende Tränke stehen oben links.",
		Tip_lucky = "Ein {r|Glückswurf}! Jeder {g|10.}, {g|20.} und {g|100.} Wurf vervielfacht die Chance auf einen seltenen Fang und auf Mutationen: {g|x2}, {g|x5}, {g|x10}. Heb ihn für ein Event auf!",
		Tip_sage = "{g|Fünf} PERFEKT in Folge! Dein nächster Wurf ist ein {r|Eremiten-Wurf} mit {g|doppelter} Kraft.",
		Tip_event = "Ein {r|Event}! {g|Fünf Minuten} lang kann ein Fang eine eigene Mutation bekommen. Der Timer oben links zeigt, wie lange es noch dauert.",
		Tip_awards = "Du hast einen {r|Erfolg} erreicht! Öffne {b|Erfolge} links und hol dir die Belohnung.",
		Tip_awards_touch = "Du hast einen {r|Erfolg} erreicht! Öffne {b|Erfolge} oben rechts und hol dir die Belohnung.",
		Tip_page = "Eine ganze {r|Seite im Bingo-Buch}! Eine volle Seite gibt einen {g|dauerhaften} Einkommensbonus.",
		Tip_rebirth = "Du kannst {r|wiedergeboren} werden! Öffne {b|Wiedergeburt} links: Chakra, Shinobi, Ryo und Laufgeschwindigkeit fangen von vorn an, aber du bekommst für immer mehr {y|Ryo}, {y|Chakra} und Mutationsglück.",
		Tip_rebirth_touch = "Du kannst {r|wiedergeboren} werden! Öffne {b|Wiedergeburt} oben rechts: Chakra, Shinobi, Ryo und Laufgeschwindigkeit fangen von vorn an, aber du bekommst für immer mehr {y|Ryo}, {y|Chakra} und Mutationsglück.",
		Tip_daily = "{r|Tägliche Belohnungen}! Komm jeden Tag: sie wachsen {g|sieben} Tage lang, jede Woche in Folge macht die nächste reicher, und lange Serien bringen {r|Boni}. Ein verpasster Tag fängt alles von vorn an.",
		Tip_community = "Auf unserem {r|Discord-Server} erscheinen {r|neue Codes} zuerst, dazu Gewinnspiele und News. Der Link steht auf der {b|Seite des Spiels} unter der Beschreibung. Codes gibst du in den {b|Einstellungen} ein.",
