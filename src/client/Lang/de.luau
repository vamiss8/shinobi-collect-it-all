		FaqA13 = "Alle Shinobi, die nicht auf einer Plattform stehen. Drück auf eine Karte, um ihn zu {r|tragen}, dann auf eine {b|Plattform}, um ihn aufzustellen. Die Leiste unten hält die besten in den Plätzen {b|3 bis 9}. Ein von der Plattform genommener Shinobi kommt zurück ins Inventar.",
		FaqQ14 = "Was ist das Bingo-Buch?",
		FaqA14 = "Alle Shinobi, die du gefangen hast, mit einer {b|Seite} pro Mutation. Ein erster Fund bringt {y|Ryo}, und eine {r|volle Seite} gibt einen {g|dauerhaften} Einkommensbonus.",
		FaqQ15 = "Was verkaufen die Läden am Brunnen?",
		FaqA15 = "{b|Tentens Ninja-Werkzeuge}: Kunai, mehr {y|Chakra} pro Wiederholung. {b|Trainingsplatz der Jugend}: {r|Laufgeschwindigkeit}, und du kannst auch langsamer laufen. {b|Missionsschalter}: {y|Ryo} für Shinobi auf letzter Mission. {b|Kabutos Heilmittel}: Tränke für {y|Kräuter}.",
		FaqQ16 = "Wie funktionieren Plattformen und Upgrades?",
		FaqA16 = "Du beginnst mit {g|5} Plattformen; kauf die nächste an ihrem Schild im Dojo. Alle {g|10} Plattformen wächst das Dojo um ein Stockwerk. Die {b|Konsole} am Fuß einer Plattform kauft Level: {g|x1,25} Einkommen pro Level, und der Shinobi wächst.",
		FaqQ17 = "Was verkauft das Shop-Fenster?",
		FaqA17 = "{r|Pässe} für immer (VIP, x2 Ryo, x2 Chakra, Glück, Plattformen), {r|Premium-Tränke} für {g|15 Minuten}, {y|Ryo}-Pakete und die {r|legendären Shinobi}, die jede Wiedergeburt überstehen.",
		FaqQ18 = "Was sind tägliche Belohnungen?",
		FaqA18 = "Jeden Tag eine Belohnung, neu um {g|Mitternacht UTC}. {g|Sieben} Tage in Folge, jeder besser als der davor; dann beginnt die Woche von vorn, {g|20 % reicher} für jede Woche in Folge (bis zum {g|Doppelten}), und die Tage {g|14}, {g|30}, {g|60} und {g|100} einer Serie bringen einen {r|Bonus} aus Kräutern und Premium-Tränken. Ein verpasster Tag fängt alles von vorn an. Sie warten in {b|Erfolge}, im Tab Täglich.",
		FaqQ19 = "Was sind Glückswürfe und der Eremiten-Wurf?",
		FaqA19 = "Jeder {g|10.}, {g|20.} und {g|100.} Wurf ist ein {r|Glückswurf}: {g|x2}, {g|x5}, {g|x10} auf die Chance eines seltenen Fangs und von Mutationen. {g|Fünf} PERFEKT in Folge machen den nächsten zum {r|Eremiten-Wurf} mit {g|doppelter} Kraft.",
		FaqQ20 = "Wo sind die Bestenlisten?",
		FaqA20 = "{b|Hinten auf dem Platz}: wessen Dojo die meisten {y|Ryo} pro Sekunde bringt und wer gerade das meiste {y|Chakra} hat.",
		FaqQ21 = "Kann ich das Tutorial noch einmal sehen?",
		FaqA21 = "Ja: {b|Einstellungen} (das Zahnrad) > {b|Hilfe} > {b|Tutorial}. Und {r|Iruka} erklärt alles Neue, wenn du ihm zum ersten Mal begegnest.",
		FaqQ22 = "Ich habe meine Antwort nicht gefunden.",
		FaqA22 = "Komm auf unseren {r|Discord-Server}: neue {r|Codes}, Gewinnspiele und Hilfe. Der Link steht auf der {b|Seite des Spiels} unter der Beschreibung. Frag dort und melde uns Fehler.",
		Change_Plaza = "Bestenlisten für Ryo und Chakra hinten auf dem Platz. Ein Geschenk für den Gruppenbeitritt hinter dem Brunnen. Erfolge und dieses Anschlagbrett. Stummschalter in den Einstellungen.",
		Change_Sound = "Sound und Musik: Schritte auf jedem Boden, Sounds für den Wurf, das Roulette und die Chakra-Kontrolle, eine Playlist für das Dorf mit einem Player in den Einstellungen, und ein Stück für die Verfolgung jeder Zone und jedes Event.",
		Change_Herbs = "Kräuter und Kabutos Heilmittel: Tränke für Kräuter, die in einem Beutel bleiben. Laufende Tränke werden auf dem Bildschirm gezeigt. Ein Shinobi, der verschmelzen kann, ist markiert, und sein Zwilling leuchtet auf seiner Plattform.",
		Change_Shop = "Der Shop: Pässe, Tränke, Ryo-Pakete und legendäre Shinobi. Sechs Sprachen und ein Einstellungsfenster.",
		Change_Ranks = "Ränge für Wiedergeburten, jeder mit eigener Startgeschwindigkeit, und die Kugeln des Rangs hinter seinem Träger.",
		Change_Events = "Events: das Blätterfest, der Akatsuki-Überfall und der Purpurmond, jedes mit einer eigenen Mutation.",
