		Guide_place = "Ты поймал шиноби! Иди по стрелкам в {b|своё додзё} и нажми на {r|светящуюся платформу}, чтобы поставить его.",
		Guide_placeFull = "Все твои платформы заняты: нажми на {r|светящуюся платформу}, чтобы {r|поменять} шиноби в руках на того, кто стоит там.",
		Guide_power = "Кунай летит так далеко, как позволяет {y|Чакра}. {r|Нажми на показатель Чакры}, вот здесь, в левом нижнем углу.",
		Guide_slider = "Здесь выбирают, сколько {y|Чакры} уйдёт на бросок: {r|двигай ползунок} или впиши число, чтобы целить в {r|зону поближе}. {r|Нажми на крестик}, чтобы закрыть.",
		Guide_tenten = "Ryo тратят в лавках. Сначала {b|Лавка Тентен}: её кунаи дают больше {y|Чакры} за повторение. Иди по стрелкам и {r|встань в круг}.",
		Guide_speed = "Дальше {b|Полигон юности}: там продают {r|скорость бега}, чтобы уходить от врагов дальних зон. {r|Встань в круг}.",
		Guide_sell = "{b|Стол миссий} платит {y|Ryo} за шиноби, которых ты отправляешь на последнюю миссию: за тех, кто больше не нужен. {r|Встань в круг}.",
		Guide_herbs = "И наконец {b|Снадобья Кабуто}: каждый донесённый улов даёт {y|травы}, а здесь на них покупают зелья, усиливающие Чакру, Ryo или удачу. {r|Встань в круг}.",
		Guide_inventory = "Теперь твои окна. {r|Нажми «Инвентарь»}: там ждут все шиноби не на платформах, нажми на любого, чтобы взять. Закрой окно, чтобы продолжить.",
		Guide_book = "{r|Нажми «Книга Бинго»}: все пойманные шиноби, по странице на каждую мутацию. Полная страница даёт постоянный бонус. Закрой, чтобы продолжить.",
		Guide_shop = "{r|Нажми «Магазин»}: пропуска навсегда, премиум-зелья, Ryo и легендарные шиноби. Закрой, чтобы продолжить.",
		Guide_awards = "{r|Нажми «Награды»}: за каждое достижение там ждёт награда, забирай её, когда появится {r|!}. Закрой, чтобы продолжить.",
		Guide_board = "Заблудился? На {b|доске объявлений} есть «Как играть», «Что нового» и все шансы: подойди и {r|встань в круг}, а потом нажимай «Читать», когда захочешь.",
		Guide_settings = "{r|Нажми на шестерёнку}: в настройках много полезного: громкость музыки и звуков, язык, простой шрифт, плеер музыки деревни и {b|Справка} с «Как играть», «Что нового», шансами и этим обучением. Закрой их, чтобы продолжить.",
		Guide_group = "Вступи в группу {r|sad mansion studios} и поставь игре лайк, потом забери {b|подарок}: {r|встань в круг}. Не засчиталось? Перезайди в игру.",
		Tip_ring = "{b|Контроль чакры}: жми, когда сжимающееся кольцо совпадёт с целью. {r|ИДЕАЛЬНО} даёт больше всего {y|Чакры}; если двинешься, инструмент уберётся.",
		Tip_reborn = "Перерождение! Чакра, шиноби, Ryo и скорость начинаются заново, зато новый ранг навсегда платит больше и даёт стартовую скорость бега. Сферы за спиной показывают твой ранг.",
		Tip_offline = "Пока тебя не было, додзё заработало {g|половину} обычного дохода, до {g|трёх дней}. Заходи почаще!",
		Tip_legend = "Это {r|легендарные шиноби}. Купленный в {b|Магазине}, такой шиноби остаётся после любого перерождения и улучшается как любой другой.",
		Tip_leaders = "{b|Таблицы лидеров}: чьё додзё приносит больше всего {y|Ryo} в секунду и у кого сейчас больше всего {y|Чакры}.",
		Tip_seal = "{r|Бонусная печать}! Нажми на неё, пока тренируешься: она на время умножает набираемую Чакру ({g|x2}, {g|x5} или {g|x10}).",
		Tip_mutation = "{r|Мутация}! С аурой шиноби приносит {g|во много раз больше}: от Чакры {g|x1,5} до Шести Путей {g|x20}. У каждой мутации своя страница в {b|Книге Бинго}, а {r|удача} повышает шанс. Все шансы есть в {b|Справке > Шансы}.",
		Tip_nextRank = "Редкая находка: шиноби {r|ранга выше}, чем у зоны. Чем глубже в зону падает кунай, тем это вероятнее.",
		Tip_caught = "Поймали! Враг забрал шиноби и оставил немного {y|Ryo}. В глубине зоны враги бегут быстрее: купи {r|скорость бега} на {b|Полигоне юности}. Прогноз броска показывает, от кого ты убежишь.",
		Tip_herbs = "{y|Травы}! Их даёт каждый донесённый улов: больше из дальних зон и {g|вдвое} за {r|ИДЕАЛЬНО}. Покупай на них зелья в {b|Снадобьях Кабуто}.",
		Tip_twin = "У этого шиноби есть {r|точный двойник}: тот же шиноби, мутация и звёзды. Открой {b|Инвентарь} и нажми {r|Слить} или отнеси его на платформу двойника. Пока слияние ждёт, Инвентарь светится фиолетовым.",
		Tip_merged = "{r|Слияние}! Звёзд стало на одну больше, а доход в {g|2,5 раза} выше. После двух золотых звёзд идут две {b|платиновые}, затем звёзды {r|Шести Путей}: три таких, всего {g|семь} слияний, — предел. Сливай двойников снова и снова.",
		Tip_upgrade = "Хватает на {r|улучшение}: пульт у платформы покупает уровни ({b|+1}, {b|+10} или {b|MAX}). Каждый уровень даёт доход {g|x1,25}, и шиноби растёт.",
		Tip_kunai = "Хватает на кунай получше в {b|Лавке Тентен}: больше {y|Чакры} за каждое повторение тренировки.",
		Tip_speed = "Можно купить {r|скорость бега} на {b|Полигоне юности}. Быстрые ноги уходят от врагов дальних зон.",
		Tip_pads = "Можно купить ещё {r|платформу}: нажми на табличку следующей в своём додзё. Больше платформ, больше дохода.",
